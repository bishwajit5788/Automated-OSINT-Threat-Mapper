# Required for public deployments. Leave unset only for local development.
AETHERMAP_API_KEY=replace-with-a-long-random-secret

# Comma-separated browser origins.
ALLOWED_ORIGINS=https://your-frontend.example

# Bounded active-scan controls.
SCAN_CONCURRENCY=32
SCAN_RATE_LIMIT=10
SCAN_RATE_WINDOW_SECONDS=60
MAX_ASSETS=25
MAX_IPS_PER_HOST=4
SCAN_CONNECT_TIMEOUT=1.5
SCAN_UDP_TIMEOUT=1.5

# Optional custom port lists.
# SCAN_PORTS=21,22,25,53,80,443,3306,5432,6379,8080,8443
# SCAN_UDP_PORTS=53,123,161,500,4500,5353

# NVD API key is optional but recommended for higher-rate public API access.
# NVD_API_KEY=
NVD_TIMEOUT=10

# Persistent SQLite files.
AETHERMAP_HISTORY_DB=data/aethermap_history.sqlite3
AETHERMAP_AUDIT_DB=data/aethermap_history.sqlite3
